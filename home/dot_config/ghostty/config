# This is the configuration file for Ghostty.
#
# Run `ghostty +show-config --default --docs` to view a list of
# all available config options and their default values.
#
# Additionally, each config option is also explained in detail
# on Ghostty's website, at https://ghostty.org/docs/config

# Config syntax crash course
# ==========================
# # The config file consists of simple key-value pairs,
# # separated by equals signs.
# font-family = Iosevka
# window-padding-x = 2
#
# # Any line beginning with a # is a comment. It's not possible to put
# # a comment after a config option, since it would be interpreted as a
# # part of the value. For example, this will have a value of "#123abc":
# background = #123abc
#
# # Empty values are used to reset config keys to default.
# key =
#
# # Some config options have unique syntaxes for their value,
# # which is explained in the docs for that config option.
# # Just for example:
# resize-overlay-duration = 4s 200ms

# 100 Mb
scrollback-limit = 100000000

#-- Window ---------------------------------------------------------------------

# gtk-titlebar = false
window-decoration = server
gtk-tabs-location = hidden
maximize = true
# fullscreen = true # disable all window manager decoration
# gtk-titlebar-hide-when-maximized = true
# adw-toolbar-style = flat

# theme = 3024 day
# theme = Aubabe
theme = Melange Light

#-- Crusor ---------------------------------------------------------------------
# The color of the bar cursor is controlled by terminal and has fixed color. It
# works if you have everywhere either dark or bright theme. But if you use dark
# theme in shell and bright in text editor --- it doesn't. This option is
# overcome for this case.
cursor-invert-fg-bg = true

#-- Font -----------------------------------------------------------------------

# font-family = Inconsolata LGC
# font-size = 13.4
# font-thicken = true

font-family = PragmataPro Mono Liga
font-size = 13.7

# Fallback Nerd font
font-family = Symbols Nerd Font

# Align the arrowhead of `───►` with its shaft.
#
# By default Ghostty draws box-drawing characters with its own sprite renderer
# (`ghostty +show-face --string="─"` says so) while `►` comes from the font.
# Two renderers, two vertical axes, so the head sits ~1px low. PragmataPro ships
# a GPOS rule correcting exactly this pair (upstream issue #159, fixed in
# v0.829); it can only fire when both glyphs are shaped in one run.
#
# BOTH ranges must be in ONE map entry. Ghostty's run iterator splits runs on
# the font-collection boundary, so mapping only U+2500-U+257F leaves `►` in the
# primary face and the pair is never shaped together — verified 2026-07-27:
# box-drawing alone did nothing, box-drawing + geometric shapes aligned them.
# ► ◄ ▼ ▲ live in U+25A0-U+25FF.
font-codepoint-map = U+2500-U+257F,U+25A0-U+25FF=PragmataPro Mono Liga

# Required by the map above — the two go together, do not remove one alone.
# Once box glyphs come from the font they span exactly ascender→descender
# (1884..-362 of 2048 upem) with no vertical overhang, and Ghostty rounds the
# cell height up, so stacked `│` show a 1px seam per row. `─` overhangs 19 units
# each side and never seams. Shrinking the cell by 1px lets the glyph cover it:
# verified solid on `│` stacks, box corners and `┼` at font-size 13.7.
# Re-check this after a font-size change — the rounding is size-dependent.
adjust-cell-height = -1

adjust-cursor-thickness = 3

#-- Shell ----------------------------------------------------------------------

command = /usr/bin/fish
shell-integration = fish

# Fix cursor in fish vi mode
# https://github.com/ghostty-org/ghostty/discussions/3836
cursor-style-blink = false
shell-integration-features = no-cursor,sudo,title

#-- Clipboard ------------------------------------------------------------------

clipboard-trim-trailing-spaces = true
copy-on-select = true

#-- Distinguish C-i from TAB and C-m from RET ----------------------------------

# Terminals send the same byte for C-i/TAB and C-m/RET.
# Emit a distinct CSI-u sequence for these two keys instead, which hel decodes
# into [C-i] / [C-m]
# 105 = 'i', 5 = Ctrl
# 109 = 'm', 5 = Ctrl
keybind = ctrl+i=csi:105;5u
keybind = ctrl+m=csi:109;5u

#-- Leader based keybindings ---------------------------------------------------

# Use <C-g> as leader key. The same as in Tmux, because I will use eighter
# ghostty tabs or tmux one.

# Send a single C-g to the app on pressing leader twice, like tmux.
# \x07 = BEL = Ctrl+G
keybind = ctrl+g>ctrl+g=text:\x07

# General
keybind = ctrl+g>r=reload_config
keybind = ctrl+g>a=select_all
keybind = ctrl+g>c=copy_to_clipboard
keybind = ctrl+g>v=paste_from_clipboard
keybind = ctrl+g>i=inspector:show
keybind = ctrl+g>q=close_surface
keybind = ctrl+g>d=close_surface

# Window
# keybind = ctrl+g>n=new_window
keybind = ctrl+g>w=toggle_fullscreen
keybind = ctrl+g>t=new_tab
keybind = ctrl+g>h=goto_split:left
keybind = ctrl+g>l=goto_split:right
keybind = ctrl+g>j=goto_split:down
keybind = ctrl+g>k=goto_split:up
keybind = ctrl+g>f=toggle_split_zoom
keybind = ctrl+g>equal=equalize_splits
